* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.prop text eol=lf
*.xml text eol=lf
*.so binary
*.zip binary

# Large, version-locked GCam payloads are stored outside regular Git objects.
gcam/apatch-startup/payload/*.apk filter=lfs diff=lfs merge=lfs -text
gcam/apatch-startup/payload/libgcastartup-cache.so filter=lfs diff=lfs merge=lfs -text

